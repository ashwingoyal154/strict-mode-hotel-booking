{
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "30 3 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
