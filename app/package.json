{
  "name": "strict-mode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Slice 1 — Strict Mode. Corporate hotel booking: in policy, near the meeting, no expense report.",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:vercel": "vite build && esbuild src/vercel-entry.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@vercel/blob": "^2.8.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
